        { "source": "docker", "target": "docker.ps" },
        { "source": "docker.ps", "target": "docker.ps.a" },
        { "source": "docker", "target": "docker.build" },
        { "source": "docker.build", "target": "docker.build.t" },
        { "source": "docker.build", "target": "docker.build.path" }
    ]
}
